# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.slnx text eol=lf
*.sql text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# Config files
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.pdf binary
*.zip binary
*.tar.gz binary
*.ttf binary
*.woff2 binary
*.eot binary

# Scripts
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf
*.dockerfile text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary